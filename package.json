{
  "name": "ringle-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "Ringle AI Tutor - Full Stack Application",
  "scripts": {
    "prepare": "husky",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "cd backend && bundle exec rspec",
    "test:frontend": "cd frontend && npm test",
    "lint": "npm-run-all lint:backend lint:frontend",
    "lint:backend": "cd backend && bundle exec rubocop",
    "lint:frontend": "cd frontend && npm run lint",
    "format": "npm-run-all format:backend format:frontend",
    "format:backend": "cd backend && bundle exec rubocop -A",
    "format:frontend": "cd frontend && npx prettier --write 'src/**/*.{ts,tsx,js,jsx}'"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "npm-run-all": "^4.1.5"
  },
  "lint-staged": {
    "backend/**/*.rb": "cd backend && bundle exec rubocop -A --force-exclusion",
    "frontend/**/*.{ts,tsx,js,jsx}": "frontend/node_modules/.bin/prettier --write"
  }
}
